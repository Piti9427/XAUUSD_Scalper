# Existing Oracle ARM VM only. This unit never passes --execute.
# Private EnvironmentFile supplies Wine paths and the expected Demo credentials.
[Unit]
Description=C22 Oracle Demo shadow (orders disabled)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/c22-demo/current
EnvironmentFile=/home/ubuntu/c22-private/c22-shadow.env
ExecStartPre=/usr/bin/sha256sum --check --status release.sha256
ExecStart=/usr/bin/env MT5_ENABLE_DEMO_ORDER_SEND=0 /usr/bin/xvfb-run -a ${DEMO_WINE_BIN} ${DEMO_WINDOWS_PYTHON} -u Z:/home/ubuntu/c22-demo/current/scripts/ops/mt5_wine_c22h4.py --watch --initialize-timeout-ms 90000 --journal Z:/home/ubuntu/c22-demo/state/c22h4-shadow.sqlite3 --cost-policy Z:/home/ubuntu/c22-demo/state/cost-policy-runtime.json --cache-output Z:/home/ubuntu/c22-demo/state/c22h4-shadow-bars.csv
Restart=on-failure
RestartSec=10
KillSignal=SIGINT
KillMode=control-group
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
Nice=5

[Install]
WantedBy=multi-user.target
