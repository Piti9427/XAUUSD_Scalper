# ==============================================================================
# XAUUSD Trading System .gitignore
# ==============================================================================

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
.venv
.venv/
env/
venv/
ENV/

# Configuration Secrets & Overrides
config/settings.yaml
.env
.env.local
.env.*.local

# Databases & Runtime SQLite
*.db
*.sqlite
*.sqlite3
data/*.db
data/smc_trades.db
data/news_cache.json
data/setup_registry.json
data/risk_halt_state.json

# Logs and generated tester artifacts
*.log
logs/
*.jsonl
*.state
*.ex5
*.htm
*.npy
*.npz

# Historical CSV Datasets (Large Data)
data/*.csv
data/**/*.csv
!data/.gitkeep

# Local backtest, research, and probe dumps
COMPLETE
data/**/*.json
data/b1_*/
data/bottradegold_*/
data/research_cache/
data/research_output*/
data/research_results/

# Chart Snapshots
data/*.png
*.png

# macOS & IDE Files
.DS_Store
.vscode/
.idea/
.scratch/
.codegraph/

# Deployment Artefacts
deploy/swapfile

# Scratch & Diagnostic Scripts
scripts/diagnose_gates.py
scripts/simulate_gold_enhancements.py
scripts/test_tuning.py

# Broker Demo exports and account metadata stay local
data/exness-demo/

# Immutable local strategy campaign evidence and source snapshots
data/strategy_*campaign*/

# Trial30 single-writer SQLite lock database
data/*.sqlite3.lock
data/trial30-demo-watch.pid
