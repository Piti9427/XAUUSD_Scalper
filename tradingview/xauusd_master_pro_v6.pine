//@version=6
indicator("XAUUSD Master Pro System [SMC + TSS + GSS + Institutional Alerts]", shorttitle="XAU Master", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// =============================================================================
// 1. GENERAL & EXECUTION SETTINGS (ADR-023)
// =============================================================================
G_GEN          = "1. General & Execution Settings"
tradeDirection = input.string("Both", "Trade Direction", options=["Both", "Long Only", "Short Only"], group=G_GEN)
signalMode     = input.string("All Institutional", "Signal Engine Mode", options=["All Institutional", "SMC Prime Only", "TSS (Turtle Soup) Only", "GSS (Golden Zone OTE) Only"], group=G_GEN, tooltip="Choose single strategy mode or All Institutional for confluence priority")
visualPreset   = input.string("Balanced (Clean)", "Visual Preset Mode", options=["Balanced (Clean)", "Minimal (Signals Only)", "Full Analytics"], group=G_GEN, tooltip="Balanced = HUD + Signals + Levels; Minimal = Signals Only; Full = All Boxes & Historical Zones")
awaitBarClose  = input.bool(true, "Await Bar Confirmation (Zero Repaint)", group=G_GEN, tooltip="Triggers strictly on confirmed bar close")

isFullAnalytics = (visualPreset == "Full Analytics")
isMinimal       = (visualPreset == "Minimal (Signals Only)")
isBalanced      = (visualPreset == "Balanced (Clean)")

showIndicators  = not isMinimal
showExtraLines  = isFullAnalytics

// =============================================================================
// 2. SESSION KILLZONES, JUDAS SWING & SILVER BULLET (UTC) [ADR-007]
// =============================================================================
G_SESS           = "2. Session Engine (UTC)"
useSessionFilter = input.bool(true, "Filter Entries by Killzones", group=G_SESS)
showSessionBg    = input.bool(true, "Highlight Killzone Backgrounds", group=G_SESS)
filterRollover   = input.bool(true, "Block Signals During Rollover (20:55-23:00 UTC)", group=G_SESS)

t_hour = hour(time, "UTC")
t_min  = minute(time, "UTC")
t_mins = t_hour * 60 + t_min

// Standardized Session Timers (ADR-007)
inAsian    = (t_hour >= 0 and t_hour < 7)
inLondonKZ = (t_mins >= (7 * 60) and t_mins < (10 * 60 + 30))
inLondonLiq= (t_mins >= (7 * 60) and t_mins < (12 * 60))
inNYKZ     = (t_mins >= (12 * 60 + 30) and t_mins < (16 * 60 + 30))
inRollover = (t_mins >= (20 * 60 + 55) and t_mins < (23 * 60))

isJudasWindow  = (t_hour == 7) or (t_hour == 8 and t_min <= 30)
isSilverBullet = (t_hour == 7) or (t_hour == 14)

isKillzoneActive = not useSessionFilter or (inLondonKZ or inNYKZ)
isTimeAllowed    = isKillzoneActive and (not filterRollover or not inRollover)

bgcolor(showSessionBg and showIndicators and inLondonKZ ? color.new(color.blue, 93) : na, title="London Killzone")
bgcolor(showSessionBg and showIndicators and inNYKZ ? color.new(color.orange, 93) : na, title="NY Killzone")

// =============================================================================
// 3. ZERO-REPAINT HTF TREND BIAS & SMT DIVERGENCE (DXY) [ADR-006, ADR-022]
// =============================================================================
G_HTF        = "3. Macro HTF Trend & SMT Divergence"
useHtfFilter = input.bool(true, "Use H1 EMA 200 Trend Filter (Zero Repaint)", group=G_HTF)
useSmtFilter = input.bool(true, "Detect SMT Divergence (vs DXY)", group=G_HTF)
dxyTicker    = input.string("TVC:DXY", "DXY Ticker Symbol", group=G_HTF)

h1_close_conf  = request.security(syminfo.tickerid, "60", close[1], barmerge.gaps_off, barmerge.lookahead_off)
h1_ema200_conf = request.security(syminfo.tickerid, "60", ta.ema(close, 200)[1], barmerge.gaps_off, barmerge.lookahead_off)

htfBullish = not useHtfFilter or (h1_close_conf > h1_ema200_conf)
htfBearish = not useHtfFilter or (h1_close_conf < h1_ema200_conf)

dxyHighConf  = request.security(dxyTicker, timeframe.period, high[1], barmerge.gaps_off, barmerge.lookahead_off)
dxyLowConf   = request.security(dxyTicker, timeframe.period, low[1], barmerge.gaps_off, barmerge.lookahead_off)
dxySwingHigh = ta.highest(dxyHighConf, 10)
dxySwingLow  = ta.lowest(dxyLowConf, 10)

// =============================================================================
// 4. MULTI-SESSION LIQUIDITY CASCADE (ADR-017)
// =============================================================================
G_LIQ             = "4. Liquidity Pools & Swing Extremums"
maxSweepPiercePts = input.float(8.0, "Max Sweep Pierce ($) [ADR-002]", step=0.5, group=G_LIQ)
minSweepPiercePts = input.float(0.30, "Min Sweep Pierce ($)", step=0.05, group=G_LIQ)

pdh = request.security(syminfo.tickerid, "D", high[1], barmerge.gaps_off, barmerge.lookahead_off)
pdl = request.security(syminfo.tickerid, "D", low[1], barmerge.gaps_off, barmerge.lookahead_off)

var float asianHigh  = na
var float asianLow   = na
var float currAsianH = na
var float currAsianL = na

isNewAsianDay = ta.change(dayofmonth(time, "UTC")) != 0

if isNewAsianDay
    currAsianH := na
    currAsianL := na

if inAsian
    currAsianH := math.max(nz(currAsianH, high), high)
    currAsianL := math.min(nz(currAsianL, low), low)
    asianHigh  := currAsianH
    asianLow   := currAsianL

var float londonHigh  = na
var float londonLow   = na
var float currLondonH = na
var float currLondonL = na

if inLondonLiq and not inLondonLiq[1]
    currLondonH := high
    currLondonL := low
else if inLondonLiq
    currLondonH := math.max(nz(currLondonH, high), high)
    currLondonL := math.min(nz(currLondonL, low), low)
    londonHigh  := currLondonH
    londonLow   := currLondonL

plot(showIndicators ? asianHigh : na, "Asian High", color=color.new(#9c27b0, 40), style=plot.style_circles)
plot(showIndicators ? asianLow : na, "Asian Low", color=color.new(#9c27b0, 40), style=plot.style_circles)
plot(showIndicators ? londonHigh : na, "London High", color=color.new(#2196f3, 50), style=plot.style_line)
plot(showIndicators ? londonLow : na, "London Low", color=color.new(#2196f3, 50), style=plot.style_line)
plot(showIndicators ? pdh : na, "PDH", color=color.new(color.red, 60), style=plot.style_line)
plot(showIndicators ? pdl : na, "PDL", color=color.new(color.green, 60), style=plot.style_line)

isSwingHigh = (high[2] > high[0]) and (high[2] > high[1]) and (high[2] > high[3]) and (high[2] > high[4])
isSwingLow  = (low[2] < low[0]) and (low[2] < low[1]) and (low[2] < low[3]) and (low[2] < low[4])
var float lastSwingHigh    = na
var float lastSwingLow     = na
var int   lastSwingHighBar = na
var int   lastSwingLowBar  = na

if isSwingHigh
    lastSwingHigh    := high[2]
    lastSwingHighBar := bar_index - 2
if isSwingLow
    lastSwingLow     := low[2]
    lastSwingLowBar  := bar_index - 2

sweepLowAsian  = not inAsian and (low < asianHigh) and (low < asianLow) and (close >= asianLow) and ((asianLow - low) <= maxSweepPiercePts) and ((asianLow - low) >= minSweepPiercePts)
sweepLowPdl    = (low < pdl) and (close >= pdl) and ((pdl - low) <= maxSweepPiercePts) and ((pdl - low) >= minSweepPiercePts)
sweepLowLondon = inNYKZ and not na(londonLow) and (low < londonLow) and (close >= londonLow) and ((londonLow - low) <= maxSweepPiercePts) and ((londonLow - low) >= minSweepPiercePts)
isSweepLow     = sweepLowAsian or sweepLowPdl or sweepLowLondon

sweepHighAsian = not inAsian and (high > asianLow) and (high > asianHigh) and (close <= asianHigh) and ((high - asianHigh) <= maxSweepPiercePts) and ((high - asianHigh) >= minSweepPiercePts)
sweepHighPdh   = (high > pdh) and (close <= pdh) and ((high - pdh) <= maxSweepPiercePts) and ((high - pdh) >= minSweepPiercePts)
sweepHighLondon= inNYKZ and not na(londonHigh) and (high > londonHigh) and (close <= londonHigh) and ((high - londonHigh) <= maxSweepPiercePts) and ((high - londonHigh) >= minSweepPiercePts)
isSweepHigh    = sweepHighAsian or sweepHighPdh or sweepHighLondon

var int   lastSweepBar       = na
var float trueSweepExtremum  = na
var int   lastSweepDir       = 0

if isSweepLow
    lastSweepBar      := bar_index
    trueSweepExtremum := low
    lastSweepDir      := 1
else if lastSweepDir == 1 and (bar_index - nz(lastSweepBar, 0) <= 8)
    trueSweepExtremum := math.min(nz(trueSweepExtremum, low), low)

if isSweepHigh
    lastSweepBar      := bar_index
    trueSweepExtremum := high
    lastSweepDir      := -1
else if lastSweepDir == -1 and (bar_index - nz(lastSweepBar, 0) <= 8)
    trueSweepExtremum := math.max(nz(trueSweepExtremum, high), high)

isSmtBullish = useSmtFilter and (low <= nz(lastSwingLow, low)) and (dxyHighConf <= dxySwingHigh)
isSmtBearish = useSmtFilter and (high >= nz(lastSwingHigh, high)) and (dxyLowConf >= dxySwingLow)
isJudasSweep = isJudasWindow and (isSweepLow or isSweepHigh)

// =============================================================================
// 5. SMC PRIME ENGINE (SWEEP + MSS + FVG LIMIT PENDING) [ADR-003, 004, 005, 014]
// =============================================================================
G_SMC         = "5. SMC Prime Parameters"
minDispRatio  = input.float(0.45, "Min Displacement Body Ratio [ADR-004]", step=0.05, group=G_SMC)
minFvgSizePts = input.float(0.30, "Min FVG Gap Size ($) [ADR-004]", step=0.05, group=G_SMC)
orderTtlBars  = input.int(4, "Limit Order TTL (Bars) [ADR-005]", minval=1, maxval=10, group=G_SMC)

candleRange    = high - low
candleBody     = math.abs(close - open)
isDisplacement = (candleRange > 0) and ((candleBody / candleRange) >= minDispRatio)
barsSinceSweep = bar_index - nz(lastSweepBar, 0)

canMssBullish = (lastSweepDir == 1) and (barsSinceSweep <= 8) and (barsSinceSweep > 0)
canMssBearish = (lastSweepDir == -1) and (barsSinceSweep <= 8) and (barsSinceSweep > 0)

isMssBullish = canMssBullish and (close > lastSwingHigh) and (close > open) and isDisplacement and htfBullish and isTimeAllowed
isMssBearish = canMssBearish and (close < lastSwingLow) and (close < open) and isDisplacement and htfBearish and isTimeAllowed

var int lastMssBar = na
var int lastMssDir = 0

if isMssBullish
    lastMssBar := bar_index
    lastMssDir := 1
if isMssBearish
    lastMssBar := bar_index
    lastMssDir := -1

barsSinceMss = bar_index - nz(lastMssBar, 0)

isFvgBullish = (low[0] > high[2]) and ((low[0] - high[2]) >= minFvgSizePts)
isFvgBearish = (low[2] > high[0]) and ((low[2] - high[0]) >= minFvgSizePts)

canFvgBullish = (lastMssDir == 1) and (barsSinceMss <= 4) and (barsSinceMss >= 0) and isFvgBullish
canFvgBearish = (lastMssDir == -1) and (barsSinceMss <= 4) and (barsSinceMss >= 0) and isFvgBearish

smcBuySetupReady  = canFvgBullish and isTimeAllowed and (tradeDirection != "Short Only")
smcSellSetupReady = canFvgBearish and isTimeAllowed and (tradeDirection != "Long Only")

// =============================================================================
// 6. TSS ENGINE (TURTLE SOUP STRATEGY - 20-BAR FALSE BREAKOUT)
// =============================================================================
G_TSS        = "6. TSS Engine (Turtle Soup False Breakout)"
tssLookback  = input.int(20, "TSS Lookback (Bars)", minval=5, group=G_TSS)
tssMinPierce = input.float(0.40, "TSS Min Pierce ($)", step=0.1, group=G_TSS)
tssMaxPierce = input.float(5.00, "TSS Max Pierce ($)", step=0.5, group=G_TSS)

priorHigh20 = ta.highest(high[1], tssLookback)
priorLow20  = ta.lowest(low[1], tssLookback)

tssBuySignal  = (low < priorLow20) and ((priorLow20 - low) >= tssMinPierce) and ((priorLow20 - low) <= tssMaxPierce) and (close > priorLow20) and isTimeAllowed and htfBullish and (tradeDirection != "Short Only")
tssSellSignal = (high > priorHigh20) and ((high - priorHigh20) >= tssMinPierce) and ((high - priorHigh20) <= tssMaxPierce) and (close < priorHigh20) and isTimeAllowed and htfBearish and (tradeDirection != "Long Only")

// =============================================================================
// 7. GSS ENGINE (GOLDEN ZONE OTE 61.8% - 78.6% DIRECTION-VERIFIED)
// =============================================================================
G_GSS         = "7. GSS Engine (Golden Zone OTE Pullback)"
minLegSizePts = input.float(3.0, "Min Impulse Leg Size ($)", step=0.5, group=G_GSS)

isBullishImpulse = not na(lastSwingLowBar) and not na(lastSwingHighBar) and (lastSwingLowBar < lastSwingHighBar)
bullRange        = nz(lastSwingHigh - lastSwingLow, 0.0)
fib618Bull       = lastSwingHigh - (bullRange * 0.618)
fib786Bull       = lastSwingHigh - (bullRange * 0.786)

gssBuyCondition  = isBullishImpulse and (bullRange >= minLegSizePts) and (low <= fib618Bull) and (low >= fib786Bull) and (close > open) and htfBullish and isTimeAllowed and (tradeDirection != "Short Only")

isBearishImpulse = not na(lastSwingLowBar) and not na(lastSwingHighBar) and (lastSwingHighBar < lastSwingLowBar)
bearRange        = nz(lastSwingHigh - lastSwingLow, 0.0)
fib618Bear       = lastSwingLow + (bearRange * 0.618)
fib786Bear       = lastSwingLow + (bearRange * 0.786)

gssSellCondition = isBearishImpulse and (bearRange >= minLegSizePts) and (high >= fib618Bear) and (high <= fib786Bear) and (close < open) and htfBearish and isTimeAllowed and (tradeDirection != "Long Only")

gssBuySignal  = gssBuyCondition and not gssBuyCondition[1]
gssSellSignal = gssSellCondition and not gssSellCondition[1]

// =============================================================================
// 8. RISK & TWO-TIER SCALE-OUT (ADR-018/019/024)
// =============================================================================
G_RISK    = "8. Risk & Two-Tier Scale-Out (ADR-018/019/024)"
maxSlCap  = input.float(25.0, "Max SL Cap Distance ($) [ADR-019]", step=1.0, group=G_RISK, tooltip="If structural risk exceeds this cap, setup is strictly rejected")
slBuffer  = input.float(0.30, "SL Spread Buffer ($)", step=0.05, group=G_RISK)
beBuffer  = input.float(0.10, "Breakeven Buffer ($)", step=0.05, group=G_RISK)
spreadPts = input.float(0.30, "Broker Spread ($) [ADR-024]", step=0.05, group=G_RISK, tooltip="Ask-Bid spread for Long limit fills and Short TP exits")
tp1R      = input.float(1.0, "TP1 Target (R) [Close 50% & Move BE]", step=0.1, group=G_RISK)
tp2R      = input.float(2.5, "TP2 Runner Target (R)", step=0.5, group=G_RISK)

// =============================================================================
// 9. TRADE STATE MACHINE & EXECUTION COUPLING (ADR-023)
// =============================================================================
var bool   pendingActive     = false
var int    pendingDir        = 0
var float  pendingLimit      = na
var float  pendingSl         = na
var float  pendingTp1        = na
var float  pendingTp2        = na
var int    pendingBar        = na
var string pendingType       = ""
var string pendingOrderId    = ""
var bool   pendingPlacedInKz = false

var bool   tradeActive       = false
var int    tradeDir          = 0
var float  tradeEntry        = na
var float  tradeSl           = na
var float  tradeTp1          = na
var float  tradeTp2          = na
var string tradeOrderId      = ""
var bool   isBeRelocated     = false
var int    tp1Bar            = na
var string activeSignalType  = ""
var string lastSignalDisplay = "Awaiting Setup"
var string expireReason      = ""

bool triggerNewPending = false
bool triggerNewMarket  = false
int  newDir            = 0
float newEntry         = na
float newSl            = na
float newTp1           = na
float newTp2           = na
string newType         = ""

bool allowSmc = (signalMode == "All Institutional" or signalMode == "SMC Prime Only")
bool allowTss = (signalMode == "All Institutional" or signalMode == "TSS (Turtle Soup) Only")
bool allowGss = (signalMode == "All Institutional" or signalMode == "GSS (Golden Zone OTE) Only")

if allowSmc and not tradeActive and not pendingActive
    if smcBuySetupReady
        fvgCe = (low[0] + high[2]) / 2.0
        rawSl = trueSweepExtremum - slBuffer
        dist  = fvgCe - rawSl
        if dist > 0 and dist <= maxSlCap
            triggerNewPending := true
            newDir   := 1
            newEntry := fvgCe
            newSl    := rawSl
            newTp1   := fvgCe + (dist * tp1R)
            newTp2   := fvgCe + (dist * tp2R)
            newType  := "SMC_PRIME"
    else if smcSellSetupReady
        fvgCe = (high[0] + low[2]) / 2.0
        rawSl = trueSweepExtremum + slBuffer
        dist  = rawSl - fvgCe
        if dist > 0 and dist <= maxSlCap
            triggerNewPending := true
            newDir   := -1
            newEntry := fvgCe
            newSl    := rawSl
            newTp1   := fvgCe - (dist * tp1R)
            newTp2   := fvgCe - (dist * tp2R)
            newType  := "SMC_PRIME"

if allowTss and not tradeActive and not pendingActive and not triggerNewPending
    if tssBuySignal
        rawSl = low - slBuffer
        dist  = close - rawSl
        if dist > 0 and dist <= maxSlCap
            triggerNewMarket := true
            newDir   := 1
            newEntry := close
            newSl    := rawSl
            newTp1   := close + (dist * tp1R)
            newTp2   := close + (dist * tp2R)
            newType  := "TSS"
    else if tssSellSignal
        rawSl = high + slBuffer
        dist  = rawSl - close
        if dist > 0 and dist <= maxSlCap
            triggerNewMarket := true
            newDir   := -1
            newEntry := close
            newSl    := rawSl
            newTp1   := close - (dist * tp1R)
            newTp2   := close - (dist * tp2R)
            newType  := "TSS"

if allowGss and not tradeActive and not pendingActive and not triggerNewPending and not triggerNewMarket
    if gssBuySignal
        rawSl = nz(lastSwingLow, low) - slBuffer
        dist  = close - rawSl
        if dist > 0 and dist <= maxSlCap
            triggerNewMarket := true
            newDir   := 1
            newEntry := close
            newSl    := rawSl
            newTp1   := close + (dist * tp1R)
            newTp2   := close + (dist * tp2R)
            newType  := "GSS_OTE"
    else if gssSellSignal
        rawSl = nz(lastSwingHigh, high) + slBuffer
        dist  = rawSl - close
        if dist > 0 and dist <= maxSlCap
            triggerNewMarket := true
            newDir   := -1
            newEntry := close
            newSl    := rawSl
            newTp1   := close - (dist * tp1R)
            newTp2   := close - (dist * tp2R)
            newType  := "GSS_OTE"

bool eventSetupPending = false
bool eventOrderFilled  = false
bool eventTp1Hit       = false
bool eventTradeClosed  = false
bool eventOrderExpired = false
string closeReason     = ""

barConfirmed = awaitBarClose ? barstate.isconfirmed : true

if triggerNewPending and barConfirmed
    pendingActive      := true
    pendingDir         := newDir
    pendingLimit       := newEntry
    pendingSl          := newSl
    pendingTp1         := newTp1
    pendingTp2         := newTp2
    pendingBar         := bar_index
    pendingType        := newType
    pendingOrderId     := syminfo.ticker + "_" + str.tostring(bar_index)
    pendingPlacedInKz  := isKillzoneActive
    eventSetupPending  := true
    lastSignalDisplay  := newType + (newDir == 1 ? " PENDING BUY" : " PENDING SELL")

if triggerNewMarket and barConfirmed
    tradeActive      := true
    tradeDir         := newDir
    tradeEntry       := newEntry
    tradeSl          := newSl
    tradeTp1         := newTp1
    tradeTp2         := newTp2
    tradeOrderId     := syminfo.ticker + "_" + str.tostring(bar_index)
    isBeRelocated    := false
    tp1Bar           := na
    activeSignalType := newType
    eventOrderFilled := true
    lastSignalDisplay:= newType + (newDir == 1 ? " BUY FILLED" : " SELL FILLED")

if pendingActive and not tradeActive and (bar_index > pendingBar)
    bool filled = false
    // Long limit: Ask must reach down to limit price
    if pendingDir == 1 and (low + spreadPts) <= pendingLimit
        filled := true
    // Short limit: Bid must reach up to limit price (chart shows Bid)
    else if pendingDir == -1 and high >= pendingLimit
        filled := true
        
    bool ttlExpired = (bar_index - pendingBar) >= orderTtlBars
    bool kzExpired  = pendingPlacedInKz and not isKillzoneActive
    
    if filled
        tradeActive      := true
        tradeDir         := pendingDir
        tradeEntry       := pendingLimit
        tradeSl          := pendingSl
        tradeTp1         := pendingTp1
        tradeTp2         := pendingTp2
        tradeOrderId     := pendingOrderId
        isBeRelocated    := false
        tp1Bar           := na
        activeSignalType := pendingType
        pendingActive    := false
        eventOrderFilled := true
        lastSignalDisplay:= pendingType + (tradeDir == 1 ? " BUY FILLED" : " SELL FILLED")
    else if ttlExpired or kzExpired
        pendingActive    := false
        eventOrderExpired:= true
        expireReason     := ttlExpired ? "TTL_EXPIRED" : "KILLZONE_CLOSED"
        lastSignalDisplay:= ttlExpired ? "Limit Expired (TTL)" : "Limit Expired (KZ)"

if tradeActive
    if tradeDir == 1
        // === LONG EXITS (Sell at Bid = chart price) ===
        // 1. Before BE: Original SL checked FIRST (Conservative Safety)
        if not isBeRelocated and low <= tradeSl
            tradeActive       := false
            eventTradeClosed  := true
            closeReason       := "STOP LOSS HIT 🛑"
            lastSignalDisplay := "SL Closed"
            tp1Bar            := na
        // 2. Before BE: Only if SL NOT hit, check TP1
        else if not isBeRelocated and high >= tradeTp1
            isBeRelocated := true
            tradeSl       := tradeEntry + beBuffer
            eventTp1Hit   := true
            tp1Bar        := bar_index
            // Same bar: only TP2 can trigger (DO NOT check low vs new BE)
            if high >= tradeTp2
                tradeActive       := false
                eventTradeClosed  := true
                closeReason       := "FULL TP2 HIT (+2.5R) 🎯"
                lastSignalDisplay := "TP2 Hit (+2.5R) 🎯"
                tp1Bar            := na
        // 3. After BE (subsequent bars only: bar_index > tp1Bar)
        else if isBeRelocated and bar_index > tp1Bar
            if high >= tradeTp2
                tradeActive       := false
                eventTradeClosed  := true
                closeReason       := "FULL TP2 HIT (+2.5R) 🎯"
                lastSignalDisplay := "TP2 Hit (+2.5R) 🎯"
                tp1Bar            := na
            else if low <= tradeSl
                tradeActive       := false
                eventTradeClosed  := true
                closeReason       := "BREAKEVEN HIT (+0.10) 🛡️"
                lastSignalDisplay := "BE Closed"
                tp1Bar            := na
                
    else if tradeDir == -1
        // === SHORT EXITS ===
        // 1. Before BE: Original SL checked FIRST (raw high, tradeSl already includes slBuffer)
        if not isBeRelocated and high >= tradeSl
            tradeActive       := false
            eventTradeClosed  := true
            closeReason       := "STOP LOSS HIT 🛑"
            lastSignalDisplay := "SL Closed"
            tp1Bar            := na
        // 2. Before BE: Only if SL NOT hit, check TP1 (Ask-calibrated: low + spreadPts)
        else if not isBeRelocated and (low + spreadPts) <= tradeTp1
            isBeRelocated := true
            tradeSl       := tradeEntry - beBuffer
            eventTp1Hit   := true
            tp1Bar        := bar_index
            // Same bar: only TP2 can trigger
            if (low + spreadPts) <= tradeTp2
                tradeActive       := false
                eventTradeClosed  := true
                closeReason       := "FULL TP2 HIT (+2.5R) 🎯"
                lastSignalDisplay := "TP2 Hit (+2.5R) 🎯"
                tp1Bar            := na
        // 3. After BE (subsequent bars only: bar_index > tp1Bar)
        else if isBeRelocated and bar_index > tp1Bar
            if (low + spreadPts) <= tradeTp2
                tradeActive       := false
                eventTradeClosed  := true
                closeReason       := "FULL TP2 HIT (+2.5R) 🎯"
                lastSignalDisplay := "TP2 Hit (+2.5R) 🎯"
                tp1Bar            := na
            else if high >= tradeSl
                tradeActive       := false
                eventTradeClosed  := true
                closeReason       := "BREAKEVEN HIT (+0.10) 🛡️"
                lastSignalDisplay := "BE Closed"
                tp1Bar            := na

if tradeActive and inRollover
    tradeActive       := false
    eventTradeClosed  := true
    closeReason       := "ROLLOVER FLAT (20:55 UTC) ⏰"
    lastSignalDisplay := "Rollover Flat"
    tp1Bar            := na

// =============================================================================
// 10. VISUAL PLOTS & DYNAMIC TARGET LINES
// =============================================================================
plotshape(eventSetupPending and pendingDir == 1, title="Setup Pending Buy", text="LIMIT BUY", style=shape.triangleup, location=location.belowbar, color=color.orange, textcolor=color.white, size=size.small)
plotshape(eventSetupPending and pendingDir == -1, title="Setup Pending Sell", text="LIMIT SELL", style=shape.triangledown, location=location.abovebar, color=color.orange, textcolor=color.white, size=size.small)

plotshape(eventOrderFilled and tradeDir == 1, title="Order Filled Buy", text="BUY FILLED", style=shape.labelup, location=location.belowbar, color=color.green, textcolor=color.white, size=size.small)
plotshape(eventOrderFilled and tradeDir == -1, title="Order Filled Sell", text="SELL FILLED", style=shape.labeldown, location=location.abovebar, color=color.red, textcolor=color.white, size=size.small)

var line lineEntry = na
var line lineSl    = na
var line lineTp1   = na
var line lineTp2   = na

if eventOrderFilled or (tradeActive and barstate.islast)
    line.delete(lineEntry)
    line.delete(lineSl)
    line.delete(lineTp1)
    line.delete(lineTp2)
    
    lineEntry := line.new(bar_index - 5, tradeEntry, bar_index + 15, tradeEntry, color=color.white, width=1, style=line.style_solid)
    lineSl    := line.new(bar_index - 5, tradeSl, bar_index + 15, tradeSl, color=isBeRelocated ? color.yellow : color.red, width=2, style=line.style_dashed)
    lineTp1   := line.new(bar_index - 5, tradeTp1, bar_index + 15, tradeTp1, color=color.aqua, width=1, style=line.style_dotted)
    lineTp2   := line.new(bar_index - 5, tradeTp2, bar_index + 15, tradeTp2, color=color.green, width=2, style=line.style_solid)

if eventTradeClosed
    line.delete(lineEntry)
    line.delete(lineSl)
    line.delete(lineTp1)
    line.delete(lineTp2)

// =============================================================================
// 11. DUAL ALERT ENGINE (HUMAN-READABLE CARD + STRUCTURED JSON WEBHOOK) [ADR-022, ADR-024]
// =============================================================================
smtBadge   = (isSmtBullish or isSmtBearish) ? " [SMT CONFIRMED 🌟]" : ""
judasBadge = isJudasSweep ? " [JUDAS SWING 🪤]" : ""
sbBadge    = isSilverBullet ? " [SILVER BULLET ⚡]" : ""
utcTimeStr = str.format_time(time, "yyyy-MM-dd HH:mm:ss", "UTC")

if eventSetupPending
    pendingJson = '{"event":"SETUP_PENDING","order_id":"' + pendingOrderId + '","symbol":"' + syminfo.ticker + '","dir":"' + (pendingDir == 1 ? "BUY" : "SELL") + '","type":"' + pendingType + '","limit":' + str.tostring(pendingLimit, "#.##") + ',"sl":' + str.tostring(pendingSl, "#.##") + ',"tp1":' + str.tostring(pendingTp1, "#.##") + ',"tp2":' + str.tostring(pendingTp2, "#.##") + ',"ttl":' + str.tostring(orderTtlBars) + ',"time":"' + utcTimeStr + '"}'
    pendingCard = str.format("⏳ [XAUUSD Master Pro] LIMIT SETUP PENDING!{0}{1}{2}\n📌 Engine: {3}\n🎯 Order: {4} LIMIT @ {5,number,#.##}\n🛑 SL: {6,number,#.##} (Risk: ${7,number,#.##})\n🎯 TP1 (+1.0R): {8,number,#.##} (Close 50% & Move BE)\n🎯 TP2 (+2.5R): {9,number,#.##} (Runner)\n⏳ TTL: {10} Bars\n⏰ Time: {11} UTC\n\n--- JSON WEBHOOK ---\n", smtBadge, judasBadge, sbBadge, pendingType, pendingDir == 1 ? "BUY" : "SELL", pendingLimit, pendingSl, math.abs(pendingLimit - pendingSl), pendingTp1, pendingTp2, orderTtlBars, utcTimeStr) + pendingJson
    alert(pendingCard, alert.freq_once_per_bar_close)

if eventOrderFilled
    fillJson = '{"event":"ORDER_FILLED","order_id":"' + tradeOrderId + '","symbol":"' + syminfo.ticker + '","dir":"' + (tradeDir == 1 ? "BUY" : "SELL") + '","type":"' + activeSignalType + '","entry":' + str.tostring(tradeEntry, "#.##") + ',"sl":' + str.tostring(tradeSl, "#.##") + ',"tp1":' + str.tostring(tradeTp1, "#.##") + ',"tp2":' + str.tostring(tradeTp2, "#.##") + ',"time":"' + utcTimeStr + '"}'
    fillCard = str.format("🚀 [XAUUSD Master Pro] ORDER FILLED!{0}{1}{2}\n📌 Engine: {3}\n💰 Executed: {4} @ {5,number,#.##}\n🛑 SL: {6,number,#.##} (Risk: ${7,number,#.##})\n🎯 TP1 (+1.0R): {8,number,#.##}\n🎯 TP2 (+2.5R): {9,number,#.##}\n⏰ Time: {10} UTC\n\n--- JSON WEBHOOK ---\n", smtBadge, judasBadge, sbBadge, activeSignalType, tradeDir == 1 ? "BUY" : "SELL", tradeEntry, tradeSl, math.abs(tradeEntry - tradeSl), tradeTp1, tradeTp2, utcTimeStr) + fillJson
    alert(fillCard, alert.freq_once_per_bar)

if eventTp1Hit
    tp1Json = '{"event":"TP1_HIT_MOVE_BE","order_id":"' + tradeOrderId + '","symbol":"' + syminfo.ticker + '","dir":"' + (tradeDir == 1 ? "BUY" : "SELL") + '","action":"PARTIAL_CLOSE","close_percent":50,"entry":' + str.tostring(tradeEntry, "#.##") + ',"new_sl":' + str.tostring(tradeSl, "#.##") + ',"time":"' + utcTimeStr + '"}'
    tp1Card = str.format("🎉 [XAUUSD Master Pro] TP1 (+1.0R) REACHED!\n📌 Action: Close 50% Position & Relocate SL to Breakeven (+0.10)\n🛡️ New SL (BE): {0,number,#.##}\n💰 Entry: {1,number,#.##}\n⏰ Time: {2} UTC\n\n--- JSON WEBHOOK ---\n", tradeSl, tradeEntry, utcTimeStr) + tp1Json
    alert(tp1Card, alert.freq_once_per_bar)

if eventOrderExpired
    cancelJson = '{"event":"ORDER_CANCELED","order_id":"' + pendingOrderId + '","symbol":"' + syminfo.ticker + '","reason":"' + expireReason + '","bars":' + str.tostring(orderTtlBars) + ',"time":"' + utcTimeStr + '"}'
    cancelCard = str.format("⌛ [XAUUSD Master Pro] LIMIT ORDER CANCELED!\n📌 Reason: {0}\n⏰ Time: {1} UTC\n\n--- JSON WEBHOOK ---\n", expireReason, utcTimeStr) + cancelJson
    alert(cancelCard, alert.freq_once_per_bar)

if eventTradeClosed
    closedJson = '{"event":"TRADE_CLOSED","order_id":"' + tradeOrderId + '","symbol":"' + syminfo.ticker + '","reason":"' + closeReason + '","time":"' + utcTimeStr + '"}'
    closedCard = str.format("🏁 [XAUUSD Master Pro] TRADE CLOSED!\n📌 Reason: {0}\n⏰ Time: {1} UTC\n\n--- JSON WEBHOOK ---\n", closeReason, utcTimeStr) + closedJson
    alert(closedCard, alert.freq_once_per_bar)

alertcondition(eventSetupPending, title="Setup Pending Alert", message="⏳ XAUUSD Setup Pending Limit Order")
alertcondition(eventOrderFilled,  title="Order Filled Alert",  message="🚀 XAUUSD Order Filled Entry Executed")
alertcondition(eventTp1Hit,       title="TP1 Hit & Move BE",   message="🎉 XAUUSD TP1 Hit! Close 50% & Move BE")
alertcondition(eventOrderExpired, title="Order Canceled Alert", message="⌛ XAUUSD Limit Order Canceled (TTL/KZ)")
alertcondition(eventTradeClosed,  title="Trade Closed Alert",  message="🏁 XAUUSD Position Closed (TP/SL/Rollover)")

// =============================================================================
// 12. REAL-TIME HUD DASHBOARD
// =============================================================================
var table hud = table.new(position.top_right, 2, 8, bgcolor=color.new(color.black, 20), border_width=1, border_color=color.gray)

if barstate.islast
    table.cell(hud, 0, 0, "XAUUSD Master Pro", bgcolor=color.navy, text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 0, "Status (Hardened)", bgcolor=color.navy, text_color=color.white, text_size=size.small)
    
    table.cell(hud, 0, 1, "Session", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 1, inLondonKZ ? "London KZ" : inNYKZ ? "NY KZ" : inAsian ? "Asian Range" : inRollover ? "Rollover Block" : "Off-Hours", bgcolor=isTimeAllowed ? color.green : color.gray, text_color=color.white, text_size=size.small)

    table.cell(hud, 0, 2, "H1 Trend Bias", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 2, htfBullish ? "BULLISH (H1)" : "BEARISH (H1)", bgcolor=htfBullish ? color.green : color.red, text_color=color.white, text_size=size.small)

    table.cell(hud, 0, 3, "DXY SMT Signal", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 3, isSmtBullish ? "BULLISH SMT 🌟" : isSmtBearish ? "BEARISH SMT 🌟" : "Neutral SMT", bgcolor=(isSmtBullish or isSmtBearish) ? color.purple : color.gray, text_color=color.white, text_size=size.small)

    table.cell(hud, 0, 4, "Position State", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 4, tradeActive ? (isBeRelocated ? "RUNNER (BE LOCKED)" : "ACTIVE POSITION") : (pendingActive ? "LIMIT PENDING" : "FLAT"), bgcolor=tradeActive ? color.teal : (pendingActive ? color.orange : color.navy), text_color=color.white, text_size=size.small)

    table.cell(hud, 0, 5, "Asian Pool", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 5, str.format("H: {0,number,#.#} | L: {1,number,#.#}", asianHigh, asianLow), text_color=color.yellow, text_size=size.small)

    table.cell(hud, 0, 6, "ICT Event", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 6, isJudasSweep ? "Judas Swing 🪤" : isSilverBullet ? "Silver Bullet ⚡" : "Standard Flow", bgcolor=isJudasSweep ? color.maroon : isSilverBullet ? color.teal : color.navy, text_color=color.white, text_size=size.small)

    table.cell(hud, 0, 7, "Last Signal", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 7, lastSignalDisplay, text_color=color.aqua, text_size=size.small)