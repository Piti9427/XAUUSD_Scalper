# ==============================================================================
# XAUUSD SMC Trading System Configuration Template
# Copy to config/settings.yaml and populate with your credentials
# ==============================================================================

# MetaTrader 5 Configuration
mt5:
  login: 0                  # Your MT5 account number (e.g. 12345678)
  password: ""              # Your MT5 investor or master password
  server: "Exness-MT5Real"  # e.g. "Exness-MT5Trial", "ICMarketsSC-Demo"
  symbol: "XAUUSD"          # Symbol on broker (e.g. "XAUUSD", "XAUUSDm")
  timeframe: "M5"           # Primary monitoring timeframe: M5
  # terminal_path: "C:\\Program Files\\MetaTrader 5\\terminal64.exe"  # Wine/Mac IPC; or MT5_TERMINAL_PATH

# Runtime Settings
runtime:
  log_level: "INFO"         # DEBUG, INFO, WARNING, ERROR
  dry_run: false            # true = simulate execution; false = live orders

# Telegram Copilot Notifications
telegram:
  enabled: false            # Enable to receive real-time signal cards & lifecycle updates
  token: "YOUR_BOT_TOKEN"   # Telegram Bot API token from @BotFather
  chat_id: "YOUR_CHAT_ID"   # Telegram Channel or User Chat ID
  send_charts: true         # Set true if matplotlib/requirements-viz.txt is installed

# SMC Strategy Parameters (v2 Gold Optimized)
strategy:
  risk_pct: 0.005           # 0.5% account equity risk per trade
  max_sl_cap: 25.00         # Hard cap on SL distance ($25.00 / 2500 points for Gold)
  spread_buffer: 0.30       # Broker spread buffer added to SL ($0.30 / 30 points)
  max_spread: 0.35          # Real-time Spread Guard: Abort entry if spread > $0.35
  tp_r: 2.5                 # Final Take Profit multiplier (2.5R Runner)
  be_enabled: false         # Foundation BaselinePlay: no automatic BE
  be_trigger_r: 1.0         # Used only when be_enabled=true
  partial_tp_enabled: false # Foundation BaselinePlay: no scale-out
  partial_tp_r: 1.0         # First Partial TP trigger (+1.0R) when enabled
  partial_tp_ratio: 0.50    # Close 50% at Partial TP when enabled
  order_ttl_bars: 4         # Limit order expiration (4 bars = 20 min on M5)
  max_daily_losses: 2       # Circuit Breaker: Halt trading after 2 losses in 1 UTC day
  cooldown_mins: 30         # Post-loss cooldown timer (30 minutes)
  extended_killzones: true  # London 07:00-10:30 UTC, NY 12:30-16:30 UTC
  min_body_ratio: 0.45      # Displacement candle body ratio (45% for Gold wicks)
  max_sweep_pierce: 8.0     # Max wick pierce beyond liquidity level ($8.00)
  sweep_lookback: 25        # Bars to look back for sweep detection
  max_sweep_to_mss_bars: 8
  max_mss_to_fvg_bars: 4
  require_choch: true

# DXY Macro Trend Gate (Optional)
dxy:
  enabled: false            # Set true to enforce inverse Dollar Index correlation
  symbol: "DXY"             # DXY ticker on broker (e.g. "USDX", "DXY_m")
  h1_ema_filter: true       # Block Gold BUY when DXY > EMA 200

# Economic News Intelligence
news:
  enabled: true             # Enable automated USD news blackout filter
  auto_fetch: true          # Auto-download weekly calendar from ForexFactory
  blackout_window_mins: 30  # Blackout window before & after high-impact USD events
  # Foundation: open positions keep SL/TP through news (no pre-news BE/force exit)

# Google Workspace Sync (Optional NotebookLM / Sheets Integration)
gws:
  enabled: false
  cli_path: "/Users/nopparuj/.gemini/extensions/google-workspace-cli/npm/run.js"
  spreadsheet_id: ""        # Google Sheet ID for trade journal sync
  doc_id: ""                # Google Doc ID for trade notes
